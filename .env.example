# Environment variables (copy to .env and fill in)
# Never commit .env — it is gitignored.

# Template update checker upstream (optional override)
# TEMPLATE_UPSTREAM=edwardlthompson/agent-project-bootstrap

# Project-specific variables (add below)
# API_BASE_URL=http://localhost:3000
# LOG_LEVEL=info

# Android release signing (for publish-foss-apk / assembleRelease)
# Prefer examples/android/keystore.properties — see keystore.properties.example
# RELEASE_STORE_FILE=openshouter-release.keystore
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=openshouter
# RELEASE_KEY_PASSWORD=
